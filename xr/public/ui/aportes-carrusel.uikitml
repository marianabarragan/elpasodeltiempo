<!-- Marco del carrusel de aportes, según el diseño: fondo gris degradado con borde blanco, títulos y botón para continuar.
     Las tarjetas (aportes-central y aportes-lateral) se agregan encima desde src/escena/aportes.js. Medidas en centímetros. -->
<style>
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-Regular.ttf"); font-weight: 400; }
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-ExtraBold.ttf"); font-weight: 800; }
  .marco { width: 96; height: 46.6; flex-direction: column; align-items: center; border-radius: 4.5; overflow: hidden; }
  .fondo { position-type: absolute; position-top: 0; position-left: 0; width: 96; height: 46.6; }
  .titulos { margin-top: 1.6; flex-direction: column; align-items: center; }
  .pildora-chica { z-index: 2; padding-top: 0.45; padding-bottom: 0.45; padding-left: 1.4; padding-right: 1.4; border-radius: 99; background-color: #ece0d6; }
  .pildora-grande { z-index: 2; margin-top: -0.6; padding-top: 0.55; padding-bottom: 0.55; padding-left: 1.4; padding-right: 1.4; border-radius: 99; background-color: #ece0d6; }
  .chico { font-family: "Raleway"; font-weight: 400; font-size: 2.3; color: #5a3a14; }
  .grande { font-family: "Raleway"; font-weight: 800; font-size: 2.6; color: #5a3a14; }
  .continuar { z-index: 2; position-type: absolute; position-right: 2.7; position-bottom: 2.3; padding-top: 0.7; padding-bottom: 0.7; padding-left: 1.3; padding-right: 1.3; border-radius: 99; background-color: #ece0d6; cursor: pointer; }
  .continuar:hover { background-color: #e0cfc1; }
  .etiqueta { font-family: "Raleway"; font-weight: 800; font-size: 1.75; color: #5a3a14; }
</style>
<div class="marco">
  <img id="fondo" class="fondo" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" />
  <div class="titulos">
    <div class="pildora-chica"><span class="chico">Pequeños gestos</span></div>
    <div class="pildora-grande"><span class="grande">GRANDES MOMENTOS</span></div>
  </div>
  <button id="continuar" class="continuar"><span class="etiqueta">CONTINUAR AL CIERRE</span></button>
</div>
