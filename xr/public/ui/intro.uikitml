<!-- Pregunta de inicio de la experiencia, con el estilo de los paneles de texto (corrección): fondo de hojas, título
     naranja en Raleway (la última línea resaltada, como en la portada) y botón naranja. Medidas en centímetros. -->
<style>
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-Regular.ttf"); font-weight: 400; }
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-ExtraBold.ttf"); font-weight: 800; }
  .panel { width: 62; height: 33; flex-direction: column; align-items: center; justify-content: center; padding-left: 4; padding-right: 4; border-radius: 4.5; border-width: 0.15; border-color: #f4f2d8; background-color: #fff9c9; overflow: hidden; }
  .hojas { position-type: absolute; position-top: 0; position-left: 0; width: 62; height: 33; border-radius: 4.5; }
  .linea { font-family: "Raleway"; font-weight: 700; font-size: 3.2; line-height: 1.25; color: #c4561f; text-align: center; }
  .resalte { font-family: "Raleway"; font-weight: 800; font-size: 3.9; line-height: 1.15; color: #c4561f; text-align: center; }
  .boton { z-index: 2; margin-top: 3.2; padding-top: 1.1; padding-bottom: 1.1; padding-left: 4.4; padding-right: 4.4; border-radius: 99; background-color: #c4561f; cursor: pointer; }
  .boton:hover { background-color: #a94617; }
  .etiqueta { font-family: "Raleway"; font-weight: 400; font-size: 2.8; color: #fbeee0; }
</style>
<div class="panel">
  <img id="hojas" class="hojas" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" />
  <span id="linea-1" class="linea">¿Te has detenido a pensar</span>
  <span id="linea-2" class="linea">cómo cambia la vida</span>
  <span id="linea-3" class="resalte">con el paso del tiempo?</span>
  <button id="inicia" class="boton"><span class="etiqueta">INICIA</span></button>
</div>
