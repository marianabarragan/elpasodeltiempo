<!-- Tarjeta lateral del carrusel de aportes (recogida y pálida): título y resumen. Medidas en centímetros. -->
<style>
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-Bold.ttf"); font-weight: 700; }
  .tarjeta { width: 24; height: 16.4; flex-direction: column; align-items: center; justify-content: center; border-radius: 4.5; border-width: 0.12; border-color: #f7f5e8; background-color: #fbf8de; overflow: hidden; }
  .hojas { position-type: absolute; position-top: 0; position-left: 0; width: 24; height: 16.4; border-radius: 4.5; }
  .pildora { z-index: 2; width: 19.5; padding-top: 0.55; padding-bottom: 0.55; align-items: center; justify-content: center; border-radius: 99; background-color: #e6c0ae; }
  .titulo { font-family: "Raleway"; font-weight: 700; font-size: 1.6; color: #fdf6ee; text-align: center; }
  .resumen { margin-top: 1.7; padding-left: 2.6; padding-right: 2.6; font-family: "Raleway"; font-weight: 700; font-size: 1.15; line-height: 1.4; color: #c9b39b; text-align: center; }
</style>
<div id="tarjeta" class="tarjeta">
  <img id="hojas" class="hojas" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" />
  <div class="pildora"><span id="titulo" class="titulo">DONA</span></div>
  <span id="resumen" class="resumen">DONA MATERIALES PARA ACTIVIDADES, ALIMENTOS O UN APORTE ECONÓMICO A UNA ORGANIZACIÓN CERCANA</span>
</div>
