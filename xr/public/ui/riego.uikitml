<!-- Indicador vertical de riego de la web (.oldage-progress): píldora crema, relleno café y el corazón
     del proyecto sobre el relleno. Medidas en centímetros (1 px de la web = 0,1 cm). El relleno usa el
     color ya mezclado con la crema (#b28b4d al 55 % = #d5bc93; borde #87622e al 55 % = #bda582). -->
<style>
  .pildora { width: 2.9; height: 13; flex-direction: column; justify-content: flex-end; align-items: stretch; padding-left: 0.6; padding-right: 0.6; padding-bottom: 0.6; border-radius: 99; background-color: #fff7e8; }
  .relleno { height: 1.9; flex-direction: column; align-items: center; padding-top: 0.5; border-radius: 0.7; border-width: 0.1; border-color: #bda582; background-color: #d5bc93; }
  .corazon { width: 1.3; height: 1.03; }
</style>
<div class="pildora">
  <div id="relleno" class="relleno">
    <img id="corazon" class="corazon" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" />
  </div>
</div>
