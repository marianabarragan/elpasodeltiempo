<!-- Instrucción breve para elegir la superficie. Medidas en centímetros. -->
<style>
  @font-face { font-family: "Barlow"; src: url("../fuentes/Barlow-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "Barlow"; src: url("../fuentes/Barlow-Light.ttf"); font-weight: 300; }
  .panel { width: 46; height: 14; flex-direction: column; align-items: center; justify-content: center; gap: 1.2; padding-left: 3; padding-right: 3; border-radius: 3; background-color: #d3e59d; overflow: hidden; }
  .hojas { position-type: absolute; position-top: 0; position-left: 0; width: 46; height: 14; }
  .texto { font-family: "Barlow"; font-weight: 700; font-size: 2.5; line-height: 1.2; color: #6b440b; text-align: center; }
  .detalle { font-family: "Barlow"; font-weight: 300; font-size: 1.8; line-height: 1.2; color: #6b440b; text-align: center; }
</style>
<div class="panel">
  <img id="hojas" class="hojas" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" />
  <span id="texto" class="texto">Selecciona una superficie para comenzar</span>
  <span id="detalle" class="detalle">Mira hacia la superficie deseada y pon una de tus manos extendida sobre esta.</span>
</div>
