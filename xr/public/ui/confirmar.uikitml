<!-- Confirmación de la superficie. Medidas en centímetros. -->
<style>
  @font-face { font-family: "Barlow"; src: url("../fuentes/Barlow-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "Barlow"; src: url("../fuentes/Barlow-Light.ttf"); font-weight: 300; }
  .panel { width: 52; height: 25; flex-direction: column; align-items: center; justify-content: center; gap: 2.2; padding-left: 3; padding-right: 3; border-radius: 3; background-color: #d3e59d; overflow: hidden; }
  .hojas { position-type: absolute; position-top: 0; position-left: 0; width: 52; height: 25; }
  .pregunta { font-family: "Barlow"; font-weight: 700; font-size: 3.2; color: #6b440b; text-align: center; }
  .aviso { font-family: "Barlow"; font-weight: 300; font-size: 1.9; line-height: 1.2; color: #6b440b; text-align: center; }
  .fila { flex-direction: row; align-items: center; gap: 2.4; }
  .boton { padding-top: 0.75; padding-bottom: 0.75; padding-left: 0.75; padding-right: 0.75; border-radius: 99; background-color: #fff7e8; cursor: pointer; }
  .centro { padding-top: 1.15; padding-bottom: 1.0; padding-left: 3.2; padding-right: 3.2; border-radius: 99; border-width: 0.12; border-color: #7a5e40; background-color: #d5bc93; }
  .centro:hover { background-color: #c9ad80; }
  .etiqueta { font-family: "Barlow"; font-weight: 700; font-size: 2.6; color: #fff7e8; }
</style>
<div class="panel">
  <img id="hojas" class="hojas" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" />
  <span id="pregunta" class="pregunta">¿Deseas utilizar esta superficie?</span>
  <span id="aviso" class="aviso" style="display: none">Esta superficie es pequeña.</span>
  <div class="fila">
    <button id="si" class="boton"><div class="centro"><span class="etiqueta">SÍ</span></div></button>
    <button id="otra" class="boton"><div class="centro"><span class="etiqueta">BUSCAR OTRA</span></div></button>
  </div>
</div>
