<!-- Confirmación de la superficie, con el estilo de los paneles de texto (corrección): fondo de hojas, título naranja,
     texto café y botones naranja en Raleway. Medidas en centímetros. -->
<style>
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-Regular.ttf"); font-weight: 400; }
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-SemiBold.ttf"); font-weight: 600; }
  @font-face { font-family: "Raleway"; src: url("../fuentes/Raleway-ExtraBold.ttf"); font-weight: 800; }
  .panel { width: 52; height: 25; flex-direction: column; align-items: center; justify-content: center; gap: 2.2; padding-left: 3; padding-right: 3; border-radius: 4; border-width: 0.15; border-color: #f4f2d8; background-color: #fff9c9; overflow: hidden; }
  .hojas { position-type: absolute; position-top: 0; position-left: 0; width: 52; height: 25; border-radius: 4; }
  .pregunta { font-family: "Raleway"; font-weight: 800; font-size: 2.9; color: #c4561f; text-align: center; }
  .aviso { font-family: "Raleway"; font-weight: 600; font-size: 1.75; line-height: 1.3; color: #5c3d10; text-align: center; }
  .fila { flex-direction: row; align-items: center; gap: 2.4; }
  .boton { z-index: 2; padding-top: 1; padding-bottom: 1; padding-left: 3.2; padding-right: 3.2; border-radius: 99; background-color: #c4561f; cursor: pointer; }
  .boton:hover { background-color: #a94617; }
  .etiqueta { font-family: "Raleway"; font-weight: 400; font-size: 2.3; color: #fbeee0; }
</style>
<div class="panel">
  <img id="hojas" class="hojas" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" />
  <span id="pregunta" class="pregunta">¿Deseas utilizar esta superficie?</span>
  <span id="aviso" class="aviso" style="display: none">Esta superficie es pequeña.</span>
  <div class="fila">
    <button id="si" class="boton"><span class="etiqueta">SÍ</span></button>
    <button id="otra" class="boton"><span class="etiqueta">BUSCAR OTRA</span></button>
  </div>
</div>
